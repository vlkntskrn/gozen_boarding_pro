rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function approved() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function admin() { return approved() && role() == 'Admin'; }
    function member(f) { return approved() && (role() in ['Admin','Supervisor'] || request.auth.uid in f.participants); }
    function clean(f) {
      return f.keys().hasOnly(['flightCode','departureAirport','arrivalAirport','etdDateText','bookedPax',
        'ownerUid','participants','reportRecipients','createdAt','closed','closedAt','recordingDeviceHash','recordingUid']) &&
        f.flightCode is string && f.departureAirport == 'DLM' && f.arrivalAirport.matches('^[A-Z]{3}$') &&
        f.etdDateText.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && f.participants is list &&
        f.participants.size() <= 50 && f.reportRecipients is list && f.reportRecipients.size() <= 10;
    }
    match /users/{uid} {
      allow read: if approved() || (request.auth != null && request.auth.uid == uid);
      allow write: if false;
    }
    match /flights/{fid} {
      allow read: if member(resource.data);
      allow create: if admin() && clean(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid && request.resource.data.closed == false &&
        request.resource.data.createdAt == request.time &&
        !request.resource.data.keys().hasAny(['recordingDeviceHash','recordingUid']);
      allow update: if clean(request.resource.data) && (
        (admin() && request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants','reportRecipients'])) ||
        (member(resource.data) && !resource.data.closed &&
          resource.data.get('recordingDeviceHash','') == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recordingDeviceHash','recordingUid']) &&
          request.resource.data.recordingDeviceHash.matches('^[a-f0-9]{64}$') && request.resource.data.recordingUid == request.auth.uid) ||
        (member(resource.data) && resource.data.recordingUid == request.auth.uid && !resource.data.closed &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['closed','closedAt']) &&
          request.resource.data.closed == true && request.resource.data.closedAt == request.time)
      );
      allow delete: if false;
      match /logs/{id} {
        allow read: if member(get(/databases/$(database)/documents/flights/$(fid)).data);
        allow create: if member(getAfter(/databases/$(database)/documents/flights/$(fid)).data) &&
          request.resource.data.keys().hasOnly(['type','byUid','at']) &&
          request.resource.data.type in ['FLIGHT_CREATED','ASSIGNMENT_CHANGED','RECORDER_CLAIMED','FLIGHT_CLOSED'] &&
          request.resource.data.byUid == request.auth.uid && request.resource.data.at == request.time;
        allow update,delete: if false;
      }
      match /{path=**} { allow read,write: if false; }
    }
    match /{path=**} { allow read,write: if false; }
  }
}
